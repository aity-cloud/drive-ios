# Aity Drive iOS Factory lanes.
#
# This file is copied by scripts/materialize.sh over the Pin's
# fastlane/Fastfile and runs from INSIDE the materialised tree
# (build/upstream). All identity rewriting below is a faithful
# transcription of the Pin's own branding flow - the `build_ipa_in_house`
# lane of upstream fastlane/Fastfile at v12.7.0 - using the same fastlane
# actions on the same files in the same order, driven by the same
# Branding.plist build.* keys. We do not call their lane directly because
# (a) it hardcodes ownCloud's team, signing identities and the
# com.owncloud.ownCloudAppShared framework id, and (b) it has no unsigned
# simulator path. ON EVERY BUMP: diff upstream's build_ipa_in_house against
# aity_apply_identity below and fold in changes (MAINTAINING.md).
#
# Lanes:
#   build_simulator_smoke    unsigned simulator build + XCUITest login-screen
#                            smoke (no Apple account needed)
#   build_staging_testflight staging IPA -> TestFlight internal
#   build_production_appstore production IPA -> App Store Connect upload
#
# Environment selection comes from build/upstream/.aity-environment written
# by scripts/materialize.sh - lanes never guess, they fail if the marker or
# the Branding.plist does not match expectations.

default_platform(:ios)

# Repo root of the FACTORY checkout (this file lives at
# <factory>/build/upstream/fastlane/Fastfile once materialised).
FACTORY_ROOT = File.expand_path("../../..", __dir__)

THEME_FOLDER = "ownCloud/Resources/Theming/"
THEME_PLIST = THEME_FOLDER + "Branding.plist"

# The identity table of meta/specs/aity-drive-v1.md, decision 4.
AITY_IDENTITY = {
  "production" => { app_name: "Aity Drive", app_id: "tech.aity.drive" },
  "staging" => { app_name: "Aity Drive (staging)", app_id: "tech.aity.drive.staging" }
}.freeze

# Where each Environment's realm lives (meta/specs/aity-drive-v1.md,
# "Environments and channels"). The DRIVE url is deliberately NOT here: it is
# read from the materialised Branding.plist so the smoke can never test a
# different server than the build points at.
AITY_ENVIRONMENT_ISSUERS = {
  "production" => "https://auth.aity.tech/realms/aity",
  "staging" => "https://auth.aity.works/realms/aity"
}.freeze

def aity_environment
  marker = File.expand_path("../.aity-environment", __dir__)
  unless File.exist?(marker)
    UI.user_error!("No .aity-environment marker - run scripts/materialize.sh <production|staging> first")
  end
  env = File.read(marker).strip
  UI.user_error!("Unknown environment '#{env}' in .aity-environment") unless AITY_IDENTITY.key?(env)
  env
end

def aity_ids(env)
  app_id = AITY_IDENTITY[env][:app_id]
  {
    app: app_id,
    fileprovider: "#{app_id}.fileprovider",
    fileprovider_ui: "#{app_id}.fileprovider-ui",
    intents: "#{app_id}.intents",
    share: "#{app_id}.share",
    action: "#{app_id}.action",
    # Embedded frameworks: not part of the store identity table, rewritten
    # anyway so no bundle id of ours carries the upstream trademark.
    framework: "#{app_id}.framework",
    shared: "#{app_id}.shared",
    group: "group.#{app_id}"
  }
end

def aity_require_env(vars)
  missing = vars.reject { |v| ENV[v].to_s.strip.length.positive? }
  return if missing.empty?

  UI.user_error!(
    "Missing required variables: #{missing.join(', ')}. " \
    "These are protected CI variables on the ios Factory project - see " \
    "meta/docs/runbooks/publisher-accounts.md (ASC_*/MATCH_*) and the " \
    "identity table in meta/specs/aity-drive-v1.md. Nothing is built or " \
    "signed from a workstation."
  )
end

platform :ios do
  # ---------------------------------------------------------------------
  # Identity rewriting - transcription of upstream build_ipa_in_house
  # (fastlane/Fastfile of the Pin; step comments cite it).
  # ---------------------------------------------------------------------
  private_lane :aity_apply_identity do |options|
    env = aity_environment
    ids = aity_ids(env)
    app_name = AITY_IDENTITY[env][:app_name]
    team_id = options[:team_id] # nil for the unsigned simulator build

    # Upstream: Xcode version guard from .xcode-version. Upstream calls
    # fastlane's `ensure_xcode_version`, which is implemented on top of the
    # `xcode-install` gem - abandoned upstream in favour of `xcodes`, absent
    # from the Pin's Gemfile, and therefore an immediate hard failure
    # ("Add 'gem \"xcode-install\"' to your Gemfile") the moment the lane
    # first ran on a real Mac (2026-08-27, three runs, nothing else reached).
    # Same guard, same fail-fast intent, no dead dependency: compare the
    # Pin's pin against what xcodebuild actually reports.
    if File.exist?("../.xcode-version")
      want = File.read("../.xcode-version").strip
      have = `xcodebuild -version`.lines.first.to_s.strip.sub(/\AXcode\s+/, "")
      unless have == want || have.start_with?("#{want}.")
        UI.user_error!("Xcode #{want} is required by the Pin's .xcode-version, but xcodebuild reports #{have.empty? ? '(nothing - Command Line Tools only?)' : have}. Install and select it: `xcodes install #{want} --select`, or point DEVELOPER_DIR at it.")
      end
      UI.message("Xcode #{have} satisfies the Pin's .xcode-version (#{want})")
    end

    UI.user_error!("#{THEME_PLIST} missing - materialize did not lay the overlay") unless File.exist?("../" + THEME_PLIST)

    # Upstream: read build-time keys from Branding.plist.
    app_build_flags = get_info_plist_value(path: THEME_PLIST, key: "build.flags") || ""
    app_custom_app_scheme = get_info_plist_value(path: THEME_PLIST, key: "build.custom-app-scheme") || ""
    app_custom_auth_scheme = get_info_plist_value(path: THEME_PLIST, key: "build.custom-auth-scheme") || ""
    app_group = get_info_plist_value(path: THEME_PLIST, key: "build.app-group-identifier") || ""
    UI.user_error!("build.app-group-identifier missing from Branding.plist") if app_group.empty?
    UI.user_error!("Branding app group '#{app_group}' != identity table '#{ids[:group]}'") if app_group != ids[:group]

    # Upstream: record app + sdk git state in Branding.plist (About screen).
    commit = sh("git rev-parse --short HEAD").strip
    sdkcommit = sh("git -C ../ios-sdk/ rev-parse --short HEAD").strip
    set_info_plist_value(path: THEME_PLIST, key: "GitHash", value: commit)
    set_info_plist_value(path: THEME_PLIST, key: "SDKGitHash", value: sdkcommit)

    UI.message("Aity identity: env=#{env} app=#{ids[:app]} group=#{ids[:group]} flags='#{app_build_flags}'")

    # Upstream: build flags that must ALSO strip Info.plist preprocessor
    # sections (set_info_plist_value loses #ifndef blocks, hence sed).
    if app_build_flags.include?("DISABLE_BACKGROUND_LOCATION")
      sh "sed '/#ifndef DISABLE_BACKGROUND_LOCATION/,/#endif/d' ../ownCloud/Resources/Info.plist >../ownCloud/Resources/Info.plist.mod"
      sh "mv ../ownCloud/Resources/Info.plist.mod ../ownCloud/Resources/Info.plist"
    end
    if app_build_flags.include?("DISABLE_PLAIN_HTTP")
      sh "sed '/#ifndef DISABLE_PLAIN_HTTP/,/#endif/d' ../ownCloud/Resources/Info.plist >../ownCloud/Resources/Info.plist.mod"
      sh "mv ../ownCloud/Resources/Info.plist.mod ../ownCloud/Resources/Info.plist"
    end

    # Upstream: URL scheme rewriting via the octype markers in
    # ownCloud/Resources/Info.plist (update_url_schemes cannot reach the
    # second URL type, so upstream seds the markers; so do we).
    unless app_custom_app_scheme.empty?
      sh 'sed "s#<string octype=\"app\">owncloud</string>#<string>' + app_custom_app_scheme + '</string>#" ../ownCloud/Resources/Info.plist >../ownCloud/Resources/Info.plist.mod'
      sh "mv ../ownCloud/Resources/Info.plist.mod ../ownCloud/Resources/Info.plist"
    end
    unless app_custom_auth_scheme.empty?
      sh 'sed "s#<string octype=\"auth\">oc</string>#<string>' + app_custom_auth_scheme + '</string>#" ../ownCloud/Resources/Info.plist >../ownCloud/Resources/Info.plist.mod'
      sh "mv ../ownCloud/Resources/Info.plist.mod ../ownCloud/Resources/Info.plist"
    end

    # Upstream: display names. App, File Provider (+UI): the app name;
    # Share/Action extensions get their action-phrased names.
    set_info_plist_value(path: "ownCloud/Resources/Info.plist", key: "CFBundleDisplayName", value: app_name)
    set_info_plist_value(path: "ownCloud/Resources/Info.plist", key: "CFBundleName", value: app_name)
    set_info_plist_value(path: "ownCloud File Provider/Info.plist", key: "CFBundleDisplayName", value: app_name)
    set_info_plist_value(path: "ownCloud File Provider/Info.plist", key: "CFBundleName", value: app_name)
    set_info_plist_value(path: "ownCloud File Provider UI/Info.plist", key: "CFBundleDisplayName", value: app_name)
    set_info_plist_value(path: "ownCloud File Provider UI/Info.plist", key: "CFBundleName", value: app_name)
    set_info_plist_value(path: "ownCloud Share Extension/Info.plist", key: "CFBundleDisplayName", value: "Share to " + app_name)
    set_info_plist_value(path: "ownCloud Share Extension/Info.plist", key: "CFBundleName", value: app_name)
    set_info_plist_value(path: "ownCloud Action Extension/Info.plist", key: "CFBundleDisplayName", value: "Save to " + app_name)
    set_info_plist_value(path: "ownCloud Action Extension/Info.plist", key: "CFBundleName", value: app_name)

    # Upstream: localized Action Extension display names live in an
    # xcstrings JSON - replace "ownCloud" in every localization.
    xcstrings_path = "../ownCloud Action Extension/InfoPlist.xcstrings"
    json_data = JSON.parse(File.read(xcstrings_path))
    if json_data.dig("strings", "CFBundleDisplayName", "localizations")
      json_data["strings"]["CFBundleDisplayName"]["localizations"].each_value do |localization|
        localization["stringUnit"]["value"] = localization["stringUnit"]["value"].gsub("ownCloud", app_name)
      end
      File.write(xcstrings_path, JSON.pretty_generate(json_data))
    else
      UI.user_error!("CFBundleDisplayName not found in Action Extension InfoPlist.xcstrings - upstream changed the mechanism")
    end

    # Upstream: build number into every target's Info.plist. Spec: the
    # build number is CI_PIPELINE_IID, monotonic per Factory.
    build_number = options[:build_number]
    if build_number
      [
        "ownCloud/Resources/Info.plist",
        "ownCloud File Provider/Info.plist",
        "ownCloud File Provider UI/Info.plist",
        "ownCloud Share Extension/Info.plist",
        "ownCloud Action Extension/Info.plist",
        "ownCloud Intents/Info.plist"
      ].each do |plist|
        set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number.to_s)
      end
    end

    # Upstream: bundle identifiers via update_app_identifier, one per
    # Info.plist (app, both file provider parts, app framework, intents,
    # share, action).
    {
      "ownCloud/Resources/Info.plist" => ids[:app],
      "ownCloud File Provider/Info.plist" => ids[:fileprovider],
      "ownCloud File Provider UI/Info.plist" => ids[:fileprovider_ui],
      "ownCloudAppFramework/Resources/Info.plist" => ids[:framework],
      "ownCloud Intents/Info.plist" => ids[:intents],
      "ownCloud Share Extension/Info.plist" => ids[:share],
      "ownCloud Action Extension/Info.plist" => ids[:action]
    }.each do |plist_path, identifier|
      update_app_identifier(
        xcodeproj: "ownCloud.xcodeproj",
        plist_path: plist_path,
        app_identifier: identifier
      )
    end

    # ...and then make it true, per TARGET, because the line above is not
    # sufficient at this Pin. Every target here takes its identifier from
    # PRODUCT_BUNDLE_IDENTIFIER (the plists carry
    # `$(PRODUCT_BUNDLE_IDENTIFIER)`), and `update_app_identifier` decides
    # what to do by reading CFBundleIdentifier out of the plist first -
    # but `ownCloud Action Extension/Info.plist` has NO CFBundleIdentifier
    # key at all (verified in the materialised v12.7.0 tree: its only
    # CFBundle* keys are Icons, PrimaryIcon, SymbolName, DisplayName). So
    # that one target was silently skipped, kept upstream's
    # com.owncloud.ios-app.ownCloud-Action-Extension, and Xcode refused the
    # build outright: "Embedded binary's bundle identifier is not prefixed
    # with the parent app's bundle identifier" (first real Mac run,
    # 2026-08-27). Setting the build setting directly is authoritative,
    # and the missing-target check means a Bump that renames a target
    # fails loudly here instead of producing a mis-identified app.
    require "xcodeproj"
    target_ids = {
      "ownCloud" => ids[:app],
      "ownCloud File Provider" => ids[:fileprovider],
      "ownCloud File Provider UI" => ids[:fileprovider_ui],
      "ownCloudApp" => ids[:framework],
      "ownCloud Intents" => ids[:intents],
      "ownCloud Share Extension" => ids[:share],
      "ownCloud Action Extension" => ids[:action]
    }
    project = Xcodeproj::Project.open("../ownCloud.xcodeproj")
    found = []
    project.targets.each do |target|
      wanted = target_ids[target.name]
      next unless wanted
      found << target.name
      target.build_configurations.each do |config|
        config.build_settings["PRODUCT_BUNDLE_IDENTIFIER"] = wanted
      end
    end
    missing = target_ids.keys - found
    UI.user_error!("targets missing from ownCloud.xcodeproj: #{missing.join(', ')} - upstream renamed a target, fix the map") unless missing.empty?

    # APP_PRODUCT_NAME is upstream's OWN branding hook and it defaults to
    # "ownCloud": the extensions' display names are
    # "Save to $(APP_PRODUCT_NAME)" / "Share to $(APP_PRODUCT_NAME)", so
    # build 18 offered "Save to ownCloud" in the iOS share sheet
    # (2026-08-27). Set on every configuration of every target.
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["APP_PRODUCT_NAME"] = app_name
      end
    end
    project.save
    UI.message("PRODUCT_BUNDLE_IDENTIFIER set on #{found.length} targets (#{ids[:app]})")

    # Upstream's trademark survives in places Branding.plist never reaches:
    # localised UI strings ("Use ownCloud actions in Shortcuts." shipped in
    # 23 languages) and Info.plist display names. The GPL gives us the code,
    # not the name - strip it from every user-visible VALUE.
    # __dir__ is <tree>/fastlane whatever the cwd is, so the tree is its
    # parent - deriving it from Dir.pwd got this wrong once already.
    tree = File.expand_path("..", __dir__)
    sh "python3 '#{File.join(FACTORY_ROOT, 'scripts/debrand-strings.py')}' '#{tree}' '#{app_name}' '#{ids[:app]}'"

    # Upstream: app group + keychain access group in every entitlements
    # file. The keychain group is Team-ID-prefixed; without a team (the
    # unsigned simulator build ignores entitlements) a placeholder keeps
    # the file shape intact.
    keychain_team = team_id || "AITYSIMULATE"
    [
      "ownCloud/ownCloud.entitlements",
      "ownCloud File Provider/ownCloud_File_Provider.entitlements",
      "ownCloud File Provider UI/ownCloud_File_Provider_UI.entitlements",
      "ownCloud Intents/ownCloud Intents.entitlements",
      "ownCloud Share Extension/ownCloud Share Extension.entitlements",
      "ownCloud Action Extension/ownCloud Action Extension.entitlements"
    ].each do |entitlements|
      update_app_group_identifiers(entitlements_file: entitlements, app_group_identifiers: [ids[:group]])
      update_keychain_access_groups(entitlements_file: entitlements, identifiers: ["#{keychain_team}.#{ids[:group]}"])
    end

    # Upstream: OC app group keys + file provider document group.
    set_info_plist_value(path: "ownCloud File Provider/Info.plist", key: "OCAppGroupIdentifier", value: ids[:group])
    set_info_plist_value(path: "ownCloud File Provider/Info.plist", key: "OCKeychainAccessGroupIdentifier", value: ids[:group])
    set_info_plist_value(path: "ownCloud File Provider/Info.plist", key: "NSExtension", subkey: "NSExtensionFileProviderDocumentGroup", value: ids[:group])
    [
      "ownCloud File Provider UI/Info.plist",
      "ownCloud Intents/Info.plist",
      "ownCloud Share Extension/Info.plist",
      "ownCloud Action Extension/Info.plist",
      "ownCloud/Resources/Info.plist"
    ].each do |plist|
      set_info_plist_value(path: plist, key: "OCAppGroupIdentifier", value: ids[:group])
      set_info_plist_value(path: plist, key: "OCKeychainAccessGroupIdentifier", value: ids[:group])
    end

    # Upstream: regenerate AppIcon.appiconset from the branding icon
    # (fastlane-plugin-appicon; the Overlay provides branding-icon.png,
    # STG-badged for staging).
    aity_generate_appicon

    { env: env, ids: ids, app_name: app_name, build_flags: app_build_flags }
  end

  # Transcription of upstream's generate_appicon lane.
  private_lane :aity_generate_appicon do
    icon_path = THEME_FOLDER + "branding-assets/"
    icon_name = "branding-icon.png"
    output_icon_path = "../ownCloud/Resources/Assets.xcassets/"
    output_icon_name = "AppIcon.appiconset"
    UI.user_error!("#{icon_path}#{icon_name} missing - the Overlay must provide the app icon source") unless File.exist?("../" + icon_path + icon_name)

    sh("rm -rf " + output_icon_path + output_icon_name + "/*")
    appicon(
      appicon_image_file: icon_path + icon_name,
      appicon_devices: %i[ipad iphone ios_marketing],
      appicon_path: "ownCloud/Resources/Assets.xcassets/",
      appicon_name: output_icon_name
    )
  end

  # Upstream: manual signing per target (automatic_code_signing with the
  # match profile names). Only for device/store builds.
  private_lane :aity_apply_signing do |options|
    ids = options[:ids]
    team_id = options[:team_id]
    identity = options[:identity]

    {
      "ownCloud" => [ids[:app], "match AppStore #{ids[:app]}"],
      "ownCloud File Provider" => [ids[:fileprovider], "match AppStore #{ids[:fileprovider]}"],
      "ownCloud File Provider UI" => [ids[:fileprovider_ui], "match AppStore #{ids[:fileprovider_ui]}"],
      "ownCloud Intents" => [ids[:intents], "match AppStore #{ids[:intents]}"],
      "ownCloud Share Extension" => [ids[:share], "match AppStore #{ids[:share]}"],
      "ownCloud Action Extension" => [ids[:action], "match AppStore #{ids[:action]}"],
      # Frameworks: signed with the team identity, no provisioning profile
      # (same shape as upstream's ownCloudApp/ownCloudAppShared entries).
      "ownCloudApp" => [ids[:framework], nil],
      "ownCloudAppShared" => [ids[:shared], nil]
    }.each do |target, (identifier, profile)|
      params = {
        path: "ownCloud.xcodeproj",
        use_automatic_signing: options[:automatic],
        team_id: team_id,
        bundle_identifier: identifier,
        targets: [target]
      }
      unless options[:automatic]
        params[:code_sign_identity] = identity
        params[:profile_name] = profile if profile
      end
      automatic_code_signing(**params)
    end
  end

  # Shared store build: match -> identity -> signing -> gym.
  private_lane :aity_build_signed_ipa do |options|
    expected_env = options[:expected_env]

    aity_require_env(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 MATCH_PASSWORD MATCH_GIT_PRIVATE_KEY AITY_TEAM_ID])
    env = aity_environment
    if env != expected_env
      UI.user_error!(
        "Materialised tree is '#{env}' but this lane builds '#{expected_env}' - " \
        "run scripts/materialize.sh #{expected_env} first"
      )
    end

    team_id = ENV.fetch("AITY_TEAM_ID")
    build_number = ENV["CI_PIPELINE_IID"] || options[:build_number]
    UI.user_error!("No build number (CI_PIPELINE_IID) - store builds are CI-only") unless build_number

    # Temporary keychain on the runner (mac-runner.md: signing material
    # never touches the login keychain).
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8")
    )

    ids = aity_ids(env)
    signed_ids = [ids[:app], ids[:fileprovider], ids[:fileprovider_ui], ids[:intents], ids[:share], ids[:action]]

    # SIGNING MODE. Apple does NOT expose App Groups in the App Store
    # Connect API - it will not even report an assignment (the diagnostic
    # lane gets settings=nil for ids that demonstrably have one) - so every
    # App ID was associated with its group by hand in the portal, once.
    # With that done, manual profiles are correct and reproducible.
    # Default is MATCH (reproducible profiles, versioned in the certificates
    # repo, nothing improvised at release time) - flipped back on 2026-08-27
    # once every App ID carried its group. AITY_SIGNING=automatic is the
    # escape hatch: it lets Xcode register whatever is missing in the portal,
    # which is how you recover if a Bump adds a target.
    automatic = ENV["AITY_SIGNING"] == "automatic"

    if automatic
      UI.message("Signing: Xcode-managed (-allowProvisioningUpdates)")
    else
      UI.message("Signing: match profiles from the certificates repo")
      match(
        type: "appstore",
        app_identifier: signed_ids,
        team_id: team_id,
        readonly: true,
        api_key: api_key
      )
    end

    identity_info = aity_apply_identity(team_id: team_id, build_number: build_number)
    aity_apply_signing(ids: ids, team_id: team_id, identity: "Apple Distribution", automatic: automatic)

    profile_map = signed_ids.to_h { |id| [id, "match AppStore #{id}"] }

    build_app(
      project: "ownCloud.xcodeproj",
      scheme: "ownCloud",
      configuration: "Release",
      output_name: "aity-drive-#{env}-#{build_number}.ipa",
      export_method: "app-store",
      xcargs: (automatic ? "-allowProvisioningUpdates CODE_SIGN_STYLE=Automatic" : "CODE_SIGN_STYLE=Manual") +
              " APP_BUILD_FLAGS='" + identity_info[:build_flags] + "'",
      # gym pipes xcodebuild through a formatter and runs with pipefail, so a
      # MISSING formatter reports as "** ARCHIVE FAILED **" with exit 127 and
      # hides whatever the build actually did - which is exactly what the
      # first signed build did (2026-08-27: `sh: xcpretty: command not found`
      # four lines above a failure that had nothing to do with the code).
      # xcpretty is in the Gemfile for that reason; keeping the formatter
      # also keeps the console output under GitLab's 4 MB job-log cap.
      # xcbeautify from Homebrew, not xcpretty from the bundle. gym shells
      # out `xcodebuild ... | <formatter>` under pipefail, so a formatter the
      # shell cannot resolve turns into "** ARCHIVE FAILED **" with exit 127
      # and hides the build entirely. xcpretty is only a TRANSITIVE
      # dependency of fastlane, and bundler exposes executables for direct
      # dependencies, so both `xcpretty` and `bundle exec xcpretty` were
      # command-not-found (three runs, 2026-08-27). A brew binary is on PATH
      # for any shell; it is also fastlane's own recommendation.
      xcodebuild_formatter: "xcbeautify",
      # ...and the unformatted transcript lands in the workspace, shipped as
      # a job artifact, so the next failure is diagnosable without a re-run.
      buildlog_path: "gym-logs",
      export_options: automatic ?
        { method: "app-store", signingStyle: "automatic", teamID: team_id } :
        { method: "app-store", provisioningProfiles: profile_map }
    )

    { api_key: api_key, env: env, build_number: build_number }
  end

  # ---------------------------------------------------------------------
  # Public lanes
  # ---------------------------------------------------------------------

  desc "Unsigned simulator build of the materialised Environment plus the"
  desc "XCUITest smokes (login screen, and the account journey against"
  desc "staging). Needs no Apple account (CODE_SIGNING_ALLOWED=NO); needs"
  desc "Xcode, a simulator runtime and xcodegen (Brewfile)."
  lane :build_simulator_smoke do
    env = aity_environment
    ids = aity_ids(env)
    identity_info = aity_apply_identity(team_id: nil, build_number: ENV["CI_PIPELINE_IID"])

    # DerivedData lives in the FACTORY, not in the materialised tree: every
    # materialize.sh run does `git clean -fd` inside build/upstream, and
    # upstream's .gitignore covers `build/` but not `build-simulator`, so a
    # DerivedData directory in there is wiped before every single build. Out
    # here it survives, which turns the second and later runs on the Mac from
    # a full cold compile into an incremental one - the difference between
    # measuring flakiness and monopolising Raul's laptop for an afternoon.
    derived_data = File.join(FACTORY_ROOT, "build", "derived-simulator")

    app_path = Dir.glob("#{derived_data}/Build/Products/Debug-iphonesimulator/*.app").first
    if app_path && ENV["AITY_SMOKE_SKIP_BUILD"] == "true"
      UI.important("AITY_SMOKE_SKIP_BUILD=true - reusing #{app_path} without rebuilding")
    else
      # The full xcodebuild transcript goes to a FILE, never to the console:
      # teeing it flooded GitLab's 4 MB job-log cap and truncated the run at
      # "Job's log exceeded limit", so the actual error was unreadable
      # (2026-08-27, first real run on the Mac runner). On failure we print the
      # error lines and the tail, which is what a human needs anyway; the whole
      # log ships as a job artifact either way.
      # ARCHS is the host arch: the generic simulator destination otherwise
      # builds arm64 AND x86_64, doubling a cold build for a slice no Apple
      # Silicon simulator ever runs.
      sh "set -o pipefail; xcodebuild build " \
         "-project ../ownCloud.xcodeproj -scheme ownCloud -configuration Debug " \
         "-destination 'generic/platform=iOS Simulator' " \
         "-derivedDataPath '#{derived_data}' -quiet " \
         "ARCHS=$(uname -m) ONLY_ACTIVE_ARCH=NO " \
         "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' " \
         "APP_BUILD_FLAGS='#{identity_info[:build_flags]}' > xcodebuild-simulator.log 2>&1 || " \
         "{ echo '--- error lines ---'; grep -nE 'error:|BUILD FAILED|The following build commands failed' xcodebuild-simulator.log | tail -40; " \
         "echo '--- last 120 lines ---'; tail -120 xcodebuild-simulator.log; exit 1; }"

      apps = Dir.glob("#{derived_data}/Build/Products/Debug-iphonesimulator/*.app")
      UI.user_error!("Simulator build produced no .app under #{derived_data}") if apps.empty?
      app_path = apps.first
    end
    UI.success("Simulator app: #{app_path}")

    # Dedicated simulator: created on demand, reused across runs.
    sim_name = ENV["AITY_SMOKE_SIMULATOR"] || "aity-drive-smoke"
    sim_device_type = ENV["AITY_SMOKE_DEVICE_TYPE"] || "com.apple.CoreSimulator.SimDeviceType.iPhone-16"
    sh "xcrun simctl list devices | grep -q '#{sim_name}' || xcrun simctl create '#{sim_name}' '#{sim_device_type}'"
    sh "xcrun simctl bootstatus '#{sim_name}' -b"

    # The smoke XCUITest runner is a standalone xcodegen project in the
    # factory repo (smoke/); it launches the installed app by bundle id.
    smoke_dir = File.join(FACTORY_ROOT, "smoke")
    UI.user_error!("#{smoke_dir}/project.yml missing") unless File.exist?(File.join(smoke_dir, "project.yml"))
    sh "cd '#{smoke_dir}' && xcodegen generate"

    # The account journey needs the staging contract account. Absent, the
    # journey test SKIPS itself (XCTSkip) and the login-screen smoke still
    # runs - so a workstation without secrets gets a useful subset rather
    # than a red run it cannot fix.
    # The server under test is whatever the Overlay baked into the build.
    drive_url = get_info_plist_value(path: THEME_PLIST, key: "branding.profile-url").to_s
    UI.user_error!("branding.profile-url missing from Branding.plist") if drive_url.empty?
    UI.message("Smoke target: #{drive_url} (realm #{AITY_ENVIRONMENT_ISSUERS[env]})")

    contract_user = ENV["AITY_CONTRACT_USER"].to_s
    contract_password = ENV["AITY_CONTRACT_PASSWORD"].to_s
    if contract_user.empty? || contract_password.empty?
      UI.important("AITY_CONTRACT_USER / AITY_CONTRACT_PASSWORD are not set - " \
                   "the account journey will skip itself and only the login-screen smoke runs")
    end

    # Repeat runs measure flakiness. Each one starts from a FRESH install:
    # the account the previous run created lives in the app group container,
    # and a second run that finds itself already logged in is not the test
    # anybody wrote.
    repeat = (ENV["AITY_SMOKE_REPEAT"] || "1").to_i
    repeat = 1 if repeat < 1
    only = ENV["AITY_SMOKE_TESTS"].to_s   # e.g. AityDriveSmokeUITests/AccountJourneySmokeTests
    results = []

    repeat.times do |attempt|
      run = attempt + 1
      log = "xcodebuild-smoke-#{run}.log"
      result_bundle = File.join(FACTORY_ROOT, "build", "smoke-results", "run-#{run}.xcresult")
      sh "rm -rf '#{result_bundle}'"
      sh "mkdir -p '#{File.dirname(result_bundle)}'"

      sh "xcrun simctl uninstall '#{sim_name}' '#{ids[:app]}' || true"
      sh "xcrun simctl install '#{sim_name}' '#{app_path}'"

      # Same log discipline as the build above: file, not console.
      command = "set -o pipefail; " \
                "TEST_RUNNER_AITY_APP_BUNDLE_ID='#{ids[:app]}' " \
                "TEST_RUNNER_AITY_APP_NAME='#{AITY_IDENTITY[env][:app_name]}' " \
                "TEST_RUNNER_AITY_DRIVE_URL='#{drive_url}' " \
                "TEST_RUNNER_AITY_ISSUER='#{AITY_ENVIRONMENT_ISSUERS[env]}' " \
                "TEST_RUNNER_AITY_CONTRACT_USER='#{contract_user}' " \
                "TEST_RUNNER_AITY_CONTRACT_PASSWORD='#{contract_password}' " \
                "xcodebuild test -project '#{smoke_dir}/AityDriveSmoke.xcodeproj' " \
                "-scheme AityDriveSmokeUITests -quiet " \
                "-resultBundlePath '#{result_bundle}' " \
                "#{only.empty? ? '' : "-only-testing:#{only} "}" \
                "-destination 'platform=iOS Simulator,name=#{sim_name}' " \
                "> #{log} 2>&1"
      passed = system(command)
      results << passed
      unless passed
        UI.error("--- smoke run #{run} failed, error lines ---")
        sh "grep -nE 'error:|failed|Failing tests' #{log} | tail -40 || true"
        UI.error("--- last 120 lines ---")
        sh "tail -120 #{log} || true"
      end
      UI.message("smoke run #{run}/#{repeat}: #{passed ? 'PASS' : 'FAIL'}")
    end

    green = results.count(true)
    UI.message("smoke pass rate: #{green}/#{repeat}")
    # A repeat run is a MEASUREMENT, not a gate: it reports the rate and only
    # fails when nothing passed at all. A single run (the default, and what
    # the pipeline uses) still fails on the first red.
    if repeat == 1
      UI.user_error!("Simulator smoke failed for #{env} (#{ids[:app]})") if green.zero?
    elsif green.zero?
      UI.user_error!("Simulator smoke failed all #{repeat} runs for #{env} (#{ids[:app]})")
    end

    UI.success("Simulator smoke #{green}/#{repeat} green for #{env} (#{ids[:app]})")
  end

  desc "Staging Environment IPA, uploaded to the TestFlight internal track"
  desc "(spec pipeline stage publish-staging). CI-only."
  lane :build_staging_testflight do
    result = aity_build_signed_ipa(expected_env: "staging")

    upload_to_testflight(
      api_key: result[:api_key],
      app_identifier: aity_ids("staging")[:app],
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
    UI.success("Staging build #{result[:build_number]} uploaded to TestFlight internal")
  end

  desc "Production Environment IPA, uploaded to App Store Connect"
  desc "(spec pipeline stage promote; review submission is finished in"
  desc "App Store Connect until listing metadata exists). CI-only."
  lane :build_production_appstore do
    result = aity_build_signed_ipa(expected_env: "production")

    deliver(
      api_key: result[:api_key],
      app_identifier: aity_ids("production")[:app],
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
    UI.success("Production build #{result[:build_number]} uploaded to App Store Connect - submit for review there")
  end

  desc "Production Environment IPA on TestFlight - the PRE-PROD channel."
  desc "Same binary as the App Store build and pointed at drive.aity.tech;"
  desc "distributed to an external tester group (friends and family) rather"
  desc "than the public listing. CI-only."
  lane :build_preprod_testflight do
    result = aity_build_signed_ipa(expected_env: "production")
    group = ENV["AITY_TF_GROUP"] || "Friends and Family"
    external = ENV["AITY_TF_EXTERNAL"] == "true"

    # External distribution needs Beta App Review, which needs sign-in
    # credentials because the app is useless without an account (guideline
    # 2.1, same demo account as the App Store submission - spec decision 17).
    review_info = nil
    if external
      aity_require_env(%w[ASC_DEMO_USER ASC_DEMO_PASSWORD])
      review_info = {
        contact_email: ENV["ASC_CONTACT_EMAIL"] || "office@aity.ro",
        contact_first_name: ENV["ASC_CONTACT_FIRST_NAME"] || "Raul",
        contact_last_name: ENV["ASC_CONTACT_LAST_NAME"] || "Bag",
        contact_phone: ENV["ASC_CONTACT_PHONE"] || "+40735850896",
        demo_account_name: ENV.fetch("ASC_DEMO_USER"),
        demo_account_password: ENV.fetch("ASC_DEMO_PASSWORD"),
        notes: "Business file sync client. The server is fixed to " \
               "https://drive.aity.tech and sign-in is OIDC through " \
               "auth.aity.tech; use the demo account above."
      }
    end

    upload_to_testflight(
      api_key: result[:api_key],
      app_identifier: aity_ids("production")[:app],
      # External distribution cannot start until Apple finishes processing,
      # so this lane waits when it is actually distributing.
      skip_waiting_for_build_processing: !external,
      distribute_external: external,
      groups: external ? [group] : nil,
      notify_external_testers: external,
      changelog: ENV["AITY_TF_CHANGELOG"] || "Pre-production build for external testing.",
      beta_app_review_info: review_info
    )

    if external
      UI.success("Pre-prod build #{result[:build_number]} uploaded and sent to '#{group}' (Beta App Review applies to the first build)")
    else
      UI.success("Pre-prod build #{result[:build_number]} uploaded to TestFlight. Set AITY_TF_EXTERNAL=true (plus ASC_DEMO_USER/ASC_DEMO_PASSWORD) to distribute it to '#{group}'.")
    end
  end

  desc "Create the internal tester group and put every App Store Connect"
  desc "user in it, then attach the newest build. Without a group, TestFlight"
  desc "has nobody to show a build to - which is exactly what happened."
  lane :aity_setup_testflight_internal do
    aity_require_env(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8])
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_P8"))
    )

    group_name = ENV["AITY_TF_INTERNAL_GROUP"] || "Aity Internal"

    # Internal testers must be App Store Connect users. Enumerating them
    # needs an Admin key - ours is App Manager, and the call blows up - so
    # the address comes from AITY_TF_TESTER_EMAIL when it is set, and we
    # simply skip tester assignment when it is not. The GROUP still gets
    # created either way, which is the part that cannot be done later
    # without a build sitting in limbo.
    users = begin
      found = Spaceship::ConnectAPI::User.all
      UI.message("App Store Connect users: #{found.map(&:email).join(', ')}")
      found
    rescue StandardError => e
      UI.important("Cannot list App Store Connect users (#{e.class}); using AITY_TF_TESTER_EMAIL instead")
      []
    end

    extra = ENV["AITY_TF_TESTER_EMAIL"].to_s.strip

    AITY_IDENTITY.each_key do |env|
      identifier = aity_ids(env)[:app]
      app = Spaceship::ConnectAPI::App.find(identifier)
      next UI.error("#{identifier}: no App Store Connect record") if app.nil?

      group = app.get_beta_groups.find { |candidate| candidate.name == group_name }
      if group.nil?
        # Spaceship has no BetaGroup.create; group creation lives on the
        # client. Signatures have drifted between versions, so try the
        # internal-group form first and fall back to the plain one.
        # Hand-built request: spaceship's create_beta_group always sends
        # publicLinkLimitEnabled, and Apple refuses that attribute on an
        # internal group ("Public link limit cannot be applied to internal
        # group"). Only name + isInternalGroup + the app relationship.
        response = Spaceship::ConnectAPI.client.post("betaGroups", {
          data: {
            type: "betaGroups",
            attributes: { name: group_name, isInternalGroup: true },
            relationships: { app: { data: { type: "apps", id: app.id } } }
          }
        })
        group = Spaceship::ConnectAPI::BetaGroup.new(response.to_models.first.to_hash, nil) rescue response.to_models.first
        UI.success("#{identifier}: created internal group '#{group_name}'")
      else
        UI.message("#{identifier}: internal group '#{group_name}' exists")
      end

      emails = users.map(&:email)
      emails << extra unless extra.empty? || emails.include?(extra)
      UI.important("  no tester email known - add yourself under TestFlight > #{group_name} > Testers, or re-run with AITY_TF_TESTER_EMAIL") if emails.empty?

      emails.each do |email|
        Spaceship::ConnectAPI::BetaTester.create(
          beta_group_id: group.id,
          email: email,
          first_name: ENV["AITY_TF_TESTER_FIRST_NAME"] || "Aity",
          last_name: ENV["AITY_TF_TESTER_LAST_NAME"] || "Tester"
        )
        UI.success("  + #{email}")
      rescue StandardError => e
        UI.message("  #{email}: #{e.message.to_s.split("\n").first}")
      end

      build = app.get_builds(limit: 5).find { |candidate| candidate.processing_state == "VALID" }
      if build.nil?
        UI.important("  no VALID build to attach yet")
      else
        begin
          build.add_beta_groups(beta_groups: [group])
          UI.success("  build #{build.version} attached to '#{group_name}'")
        rescue StandardError => e
          UI.important("  could not attach build #{build.version}: #{e.message.to_s.split("\n").first}")
        end
      end
    end

    UI.success("Open TestFlight on the device signed in with one of those Apple IDs.")
  end

  desc "Read-only: what TestFlight actually has - builds, their processing"
  desc "state, and which tester groups exist. Answers 'why is it not on my"
  desc "phone' without guessing."
  lane :aity_check_testflight do
    aity_require_env(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8])
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_P8"))
    )

    AITY_IDENTITY.each_key do |env|
      identifier = aity_ids(env)[:app]
      app = Spaceship::ConnectAPI::App.find(identifier)
      if app.nil?
        UI.error("#{identifier}: no App Store Connect record")
        next
      end
      UI.header("#{identifier} (#{app.name})")

      builds = app.get_builds(includes: "preReleaseVersion", limit: 5)
      if builds.empty?
        UI.important("  no builds visible at all")
      end
      builds.each do |build|
        UI.message("  build #{build.version} (#{build.pre_release_version&.version}) " \
                   "processing=#{build.processing_state} expired=#{build.expired} " \
                   "uses_non_exempt_encryption=#{build.uses_non_exempt_encryption.inspect}")
      end

      groups = app.get_beta_groups
      if groups.empty?
        UI.important("  NO tester groups - nothing can reach a phone until one exists")
      end
      groups.each do |group|
        testers = begin
          group.get_beta_testers.map(&:email)
        rescue StandardError => e
          ["<unreadable: #{e.class}>"]
        end
        UI.message("  group '#{group.name}' internal=#{group.is_internal_group} testers=#{testers.join(', ')}")
      end

      # The bit that decides whether anything appears on a phone: is the
      # newest build actually ASSIGNED to a group? A group with no build and
      # a build in no group both look fine in isolation.
      newest = builds.find { |candidate| candidate.processing_state == "VALID" && !candidate.expired }
      if newest
        assigned = begin
          Spaceship::ConnectAPI.client.get("builds/#{newest.id}/betaGroups")
                                .to_models.map { |group| group.name }
        rescue StandardError => e
          ["<unreadable: #{e.class}>"]
        end
        if assigned.empty?
          UI.important("  build #{newest.version} is in NO group - that is why TestFlight shows nothing")
        else
          UI.success("  build #{newest.version} is in: #{assigned.join(', ')}")
        end
      end
    end
  end

  desc "Read-only: ask Apple which App IDs actually carry an App Group, and"
  desc "try to attach the missing ones. Prints a per-id verdict."
  lane :aity_check_app_groups do
    aity_require_env(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8])
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_P8"))
    )

    missing = []
    AITY_IDENTITY.each_key do |env|
      ids = aity_ids(env)
      group = ids[:group]
      [ids[:app], ids[:fileprovider], ids[:fileprovider_ui], ids[:intents], ids[:share], ids[:action]].each do |identifier|
        bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
        if bundle.nil?
          UI.error("#{identifier}: NO SUCH App ID")
          next
        end
        caps = bundle.get_capabilities
        app_groups = caps.find { |c| c.capability_type == "APP_GROUPS" }
        if app_groups.nil?
          UI.error("#{identifier}: App Groups capability NOT enabled")
          missing << identifier
          next
        end
        # Apple returns the assigned groups (when it returns them at all) in
        # the capability's settings; an empty/absent settings list is the
        # "ticked but nothing selected" state that fails the build.
        settings = begin
          app_groups.settings
        rescue StandardError
          nil
        end
        UI.message("#{identifier}: APP_GROUPS settings=#{settings.inspect}")
        if settings.nil? || settings.to_s.empty? || settings.to_s == "[]"
          UI.important("#{identifier}: capability on, but no group visible via the API")
          missing << identifier
        else
          UI.success("#{identifier}: group assigned")
        end
      end
      UI.message("--- #{env} expects #{group}")
    end

    if missing.empty?
      UI.success("Every App ID reports an App Group assignment.")
    else
      UI.important("")
      UI.important("These App IDs have no group visible through the API:")
      missing.each { |m| UI.important("  #{m}") }
      UI.important("If a signed build still fails on the App Group, these are the ones to fix in the portal.")
    end
  end

  # ---------------------------------------------------------------------
  # ONE-TIME Apple bootstrap. Idempotent: safe to re-run, creates only what
  # is missing. Everything it touches lives in Apple's account, not in this
  # repo, which is why it is a manual job and not part of any pipeline.
  # ---------------------------------------------------------------------
  desc "Register the App IDs, app records and signing material for BOTH"
  desc "Environments, then populate the match store. Run once per Apple team."
  lane :aity_bootstrap_apple do
    aity_require_env(%w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 MATCH_PASSWORD MATCH_GIT_PRIVATE_KEY])
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8")
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_P8"))
    )

    # 1. Bundle ids. The suffix targets are extensions and need no ASC app
    #    record; the two parent ids get one so TestFlight has somewhere to
    #    put a build.
    created = []
    team_id = nil
    AITY_IDENTITY.each_key do |env|
      ids = aity_ids(env)
      label = env == "production" ? "Aity Drive" : "Aity Drive Staging"
      [
        [ids[:app], label, true],
        [ids[:fileprovider], "#{label} File Provider", false],
        [ids[:fileprovider_ui], "#{label} File Provider UI", false],
        [ids[:framework], "#{label} App Framework", false],
        [ids[:intents], "#{label} Intents", false],
        [ids[:share], "#{label} Share Extension", false],
        [ids[:action], "#{label} Action Extension", false]
      ].each do |identifier, name, is_app|
        existing = Spaceship::ConnectAPI::BundleId.find(identifier)
        if existing.nil?
          existing = Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
          created << identifier
          UI.success("created App ID #{identifier}")
        else
          UI.message("App ID #{identifier} already exists")
        end
        team_id ||= existing.seed_id

        # Capabilities: every target shares the app group container; the
        # parent app additionally declares associated-domains (upstream
        # ships the key, empty, and a profile without it fails to sign).
        wanted = [Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS]
        wanted << Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS if is_app
        have = existing.get_capabilities.map(&:capability_type)
        wanted.each do |cap|
          next if have.include?(cap)
          begin
            existing.create_capability(cap)
            UI.success("  + #{cap} on #{identifier}")
          rescue => e
            UI.important("  ! could not enable #{cap} on #{identifier}: #{e.message}")
          end
        end
      end
    end

    UI.user_error!("Could not determine the Team ID from any bundle id") if team_id.nil?
    UI.header("Apple Team ID: #{team_id}")
    File.write(File.join(FACTORY_ROOT, "apple-team-id.txt"), team_id)

    # 2. App Store Connect records for the two parent ids. Apple's API
    #    cannot create an app record - the `apps` resource allows only
    #    GET/UPDATE ("The resource 'apps' does not allow 'CREATE'", verified
    #    2026-08-27) - so this only CHECKS, and tells the human exactly what
    #    to click when one is missing. Everything else in this lane is
    #    automatic; this is the one irreducible manual step.
    missing_records = []
    AITY_IDENTITY.each_key do |env|
      ids = aity_ids(env)
      name = env == "production" ? "Aity Drive" : "Aity Drive Staging"
      if Spaceship::ConnectAPI::App.find(ids[:app]).nil?
        missing_records << [name, ids[:app]]
        UI.important("no App Store Connect record for #{ids[:app]}")
      else
        UI.message("App Store Connect record for #{ids[:app]} exists")
      end
    end

    # 3. Signing material into the match store (this WRITES - the only lane
    #    that does; every build lane is readonly).
    all_signed = AITY_IDENTITY.keys.flat_map do |env|
      ids = aity_ids(env)
      [ids[:app], ids[:fileprovider], ids[:fileprovider_ui], ids[:intents], ids[:share], ids[:action]]
    end
    # AITY_MATCH_FORCE=true regenerates every profile even when one already
    # exists. Needed after an App ID gains a capability - a profile minted
    # before the App Group existed does not carry it, and Xcode rejects the
    # build with "doesn't support the group.* App Group" (2026-08-27).
    match(
      type: "appstore",
      app_identifier: all_signed,
      team_id: team_id,
      readonly: false,
      force: ENV["AITY_MATCH_FORCE"] == "true",
      api_key: api_key
    )

    unless missing_records.empty?
      UI.important("")
      UI.important("MANUAL STEP - create these in App Store Connect (My Apps > +):")
      missing_records.each do |name, identifier|
        UI.important("  name '#{name}'  platform iOS  bundle id #{identifier}  SKU #{identifier.tr('.', '-')}  language English (U.S.)")
      end
      UI.important("Uploads to a missing record fail; everything else above is done.")
    end

    UI.success("Bootstrap complete. Set AITY_TEAM_ID=#{team_id} as a protected group variable, then the publish lanes can run.")
    UI.important("")
    UI.important("APP GROUPS - the other thing Apple's API cannot do:")
    UI.important("  #{aity_ids('production')[:group]} and #{aity_ids('staging')[:group]}")
    UI.important("  must exist under Identifiers > App Groups AND be ticked on every")
    UI.important("  App ID above (Identifiers > <id> > App Groups > Configure).")
    UI.important("  Until then a signed build fails with \"doesn't support the")
    UI.important("  group.* App Group\". After fixing it, re-run this job with")
    UI.important("  AITY_MATCH_FORCE=true so the profiles are regenerated WITH the")
    UI.important("  group - existing profiles do not pick it up on their own.")
  end
end
